datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Usuario {
  id        Int     @id @default(autoincrement())
  nome      String
  idade     Int
  email     String  @unique
  configuracoes ConfiguracaoUsuario[]
}

model ConfiguracaoUsuario {
  id             Int     @id @default(autoincrement())
  tema           String
  emailNotificacoes Boolean
  usuarioId      Int
  usuario        Usuario @relation(fields: [usuarioId], references: [id])
}
